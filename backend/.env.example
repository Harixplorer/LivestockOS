# Application Settings
PROJECT_NAME="LivestockOS Backend API"
DEBUG=True
API_V1_STR="/api/v1"

# Database (PostgreSQL for production/docker, or SQLite for local dev)
# For local Postgres: postgresql+asyncpg://livestock:livestock_password@localhost:5432/livestockos
# For Docker: postgresql+asyncpg://livestock:livestock_password@postgres:5432/livestockos
# For local SQLite dev: sqlite+aiosqlite:///./livestockos.db
DATABASE_URL=sqlite+aiosqlite:///./livestockos.db

# JWT & Security
JWT_SECRET_KEY=dev-secret-key-change-in-production-must-be-at-least-32-chars-long
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS Allowed Origins (Comma-separated or JSON list)
CORS_ORIGINS=["http://localhost:3000","http://localhost:8000","http://localhost:5000","http://localhost:8080","http://127.0.0.1:3000","http://127.0.0.1:8000"]
